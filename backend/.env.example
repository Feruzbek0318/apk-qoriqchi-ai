# Copy to .env and fill in. NEVER commit real secrets.
APP_ENV=development                     # development | production
DATABASE_URL=postgresql+psycopg://qoriqchi:change-me@db:5432/qoriqchi
POSTGRES_PASSWORD=change-me

# Optional shared secret required to register a new client device (recommended in production).
REGISTRATION_SECRET=

# Threat intelligence providers (leave empty to disable a provider)
VIRUSTOTAL_API_KEY=
SAFE_BROWSING_API_KEY=                  # non-commercial use only
WEB_RISK_API_KEY=                       # use for commercial deployments
URL_REPUTATION_PROVIDER=safebrowsing    # safebrowsing | webrisk

# AI analyst (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Fixture mode returns clearly-labelled fake provider data for local UI work. Refused in production.
PROVIDER_FIXTURE_MODE=false

CORS_ORIGINS=[]
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=100
