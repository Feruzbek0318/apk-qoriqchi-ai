    <string name="apps_signal_accessibility_title">Accessibility service enabled</string>
    <string name="apps_signal_accessibility_desc">The app can read the screen and tap on your behalf. Legitimate for screen readers, password managers and automation tools; suspicious for anything else, especially sideloaded apps (banking trojans abuse this).</string>
    <string name="apps_signal_device_admin_title">Device administrator</string>
    <string name="apps_signal_device_admin_desc">The app can lock the screen and resist being uninstalled. Legitimate for work-profile management or find-my-device apps; suspicious otherwise.</string>
    <string name="apps_signal_sideloaded_title">Installed outside an app store</string>
    <string name="apps_signal_sideloaded_desc">Installed from an APK file rather than an official store. That alone is not malware, but the app skipped store review.</string>
    <string name="apps_signal_notification_listener_title">Notification access</string>
    <string name="apps_signal_notification_listener_desc">The app can read every notification, including SMS codes. Legitimate for watches, fitness bands and messengers; suspicious for an unknown app.</string>
    <string name="apps_signal_default_sms_title">Default SMS app</string>
    <string name="apps_signal_default_sms_desc">All SMS, including bank codes, go through this app. Fine for a well-known SMS app; suspicious if unknown or sideloaded.</string>
    <string name="apps_signal_sms_access_title">SMS permissions granted</string>
    <string name="apps_signal_sms_access_desc">The app can read, receive or send SMS. Expected for messengers or banking apps; suspicious for a game or simple utility.</string>
    <string name="apps_signal_legacy_target_sdk_title">Built for old Android</string>
    <string name="apps_signal_legacy_target_sdk_desc">The app targets a very old Android version, so permissions are granted without prompts. Often just an outdated app, but malware uses this too.</string>
    <string name="apps_signal_overlay_title">Display over other apps</string>
    <string name="apps_signal_overlay_desc">The app can draw over other apps. Legitimate for chat bubbles or screen filters; can be abused for fake login screens.</string>
    <string name="apps_signal_install_packages_title">Installs other apps</string>
    <string name="apps_signal_install_packages_desc">The app can ask to install other APKs. Expected for browsers, file managers and stores; suspicious elsewhere.</string>
    <string name="apps_signal_call_log_access_title">Call access</string>
    <string name="apps_signal_call_log_access_desc">The app can read the call log or place calls. Expected for dialers and caller-ID apps.</string>
    <string name="apps_signal_many_dangerous_title">Many dangerous permissions</string>
    <string name="apps_signal_many_dangerous_desc">The app has access to a lot of personal data. Not proof of malware, but consider revoking permissions it does not need.</string>
