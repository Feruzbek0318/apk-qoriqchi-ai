<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ApkQoriqchi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>

    <!-- System splash (Android 12+ API, back-ported by core-splashscreen). -->
    <style name="Theme.ApkQoriqchi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ApkQoriqchi</item>
    </style>
</resources>
